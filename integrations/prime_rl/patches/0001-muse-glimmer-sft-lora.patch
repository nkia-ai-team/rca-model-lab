+def test_softcapped_lm_head_applies_model_output_multiplier_forward_and_backward_cpu():
+    torch.manual_seed(17)
+    b, s, h, v = 2, 4, 8, 37
+    softcap = 30.0
+    logit_scale = 0.125
+    temperature = torch.full((b, s), 1.7, dtype=torch.float32)
+    labels = torch.randint(0, v, (b, s), dtype=torch.long)
+    hidden0 = torch.randn(b, s, h, dtype=torch.float32, requires_grad=True)
+    weight0 = torch.randn(v, h, dtype=torch.float32, requires_grad=True)
+
+    logits = hidden0 @ weight0.t()
+    logits = softcap * torch.tanh(logits * logit_scale / softcap)
+    scaled = logits / temperature.unsqueeze(-1)
+    logprobs0 = torch.log_softmax(scaled, dim=-1).gather(-1, labels.unsqueeze(-1)).squeeze(-1)
+    logprobs0.sum().backward()
+    hidden_grad0 = hidden0.grad.detach().clone()
+    weight_grad0 = weight0.grad.detach().clone()
+
+    hidden1 = hidden0.detach().clone().requires_grad_(True)
+    fused = GemmaFusedOutputLinear(h, v, 3, softcap, logit_scale)
+    fused.weight = torch.nn.Parameter(weight0.detach().clone())
+    output = fused(hidden1, labels, temperature)
+    output["logprobs"].sum().backward()
+
+    torch.testing.assert_close(output["logprobs"], logprobs0, rtol=0, atol=1e-5)
+    torch.testing.assert_close(hidden1.grad, hidden_grad0, rtol=0, atol=1e-5)
+    torch.testing.assert_close(fused.weight.grad, weight_grad0, rtol=0, atol=1e-5)
+
+    vanilla = GemmaVanillaOutputLinear(h, v, softcap, logit_scale)
+    vanilla.weight = torch.nn.Parameter(weight0.detach().clone())
+    torch.testing.assert_close(vanilla(hidden0.detach())["logits"], logits.detach())
+
+
