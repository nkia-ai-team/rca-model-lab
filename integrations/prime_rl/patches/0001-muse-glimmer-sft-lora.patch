+def _canonical_peft_key(key: str) -> str:
+    key = key.removeprefix("base_model.model.")
+    return key.replace(".lora_A.default.weight", ".lora_A.weight").replace(
+        ".lora_B.default.weight", ".lora_B.weight"
+    )
+
+
+def load_peft_adapter(path: str | Path) -> None:
+    """Load a complete PEFT adapter into already-sharded Prime LoRA modules."""
+    adapter_path = Path(path)
+    weights_path = adapter_path / "adapter_model.safetensors"
+    if not weights_path.is_file():
+        raise FileNotFoundError(f"PEFT adapter weights not found: {weights_path}")
+    source = {_canonical_peft_key(key): value for key, value in load_file(weights_path).items()}
+    expected: set[str] = set()
+    with torch.no_grad():
+        for prefix, module in get_lora_state().registered_modules():
+            for name, parameter in module.named_parameters_for_adapter(0):
+                key = f"{prefix}.{name}.weight"
+                expected.add(key)
+                if key not in source:
+                    raise ValueError(f"PEFT adapter is missing Prime LoRA tensor: {key}")
+                value = source[key]
+                if tuple(value.shape) != tuple(parameter.shape):
+                    raise ValueError(
+                        f"PEFT adapter shape mismatch for {key}: "
+                        f"{tuple(value.shape)} != {tuple(parameter.shape)}"
+                    )
+                if isinstance(parameter, DTensor):
+                    full = value.to(device=parameter.device, dtype=parameter.dtype)
+                    distributed = distribute_tensor(full, parameter.device_mesh, parameter.placements)
+                    parameter.copy_(distributed)
+                else:
+                    parameter.copy_(value.to(device=parameter.device, dtype=parameter.dtype))
+    unexpected = sorted(set(source) - expected)
+    if unexpected:
+        raise ValueError(f"PEFT adapter has unexpected LoRA tensors: {unexpected[:10]}")
+
