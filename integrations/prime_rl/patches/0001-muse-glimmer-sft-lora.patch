@@ -0,0 +1,38 @@
+import torch
+from safetensors.torch import save_file
+
+from prime_rl.configs.trainer import LoRAConfig
+from prime_rl.trainer.lora import _canonical_peft_key, load_peft_adapter, setup_lora_state
+from prime_rl.trainer.models.layers.lora import MultiLoRALinear
+
+
+def test_peft_adapter_keys_are_canonicalized_for_prime_modules() -> None:
+    assert _canonical_peft_key(
+        "base_model.model.model.language_model.layers.0.self_attn.q_proj.lora_A.default.weight"
+    ) == "model.language_model.layers.0.self_attn.q_proj.lora_A.weight"
+    assert _canonical_peft_key(
+        "base_model.model.model.language_model.layers.0.self_attn.q_proj.lora_B.weight"
+    ) == "model.language_model.layers.0.self_attn.q_proj.lora_B.weight"
+
+
+def test_peft_adapter_initializes_every_registered_prime_tensor(tmp_path) -> None:
+    state = setup_lora_state(LoRAConfig(rank=2, alpha=4), torch.device("cpu"))
+    module = MultiLoRALinear(torch.nn.Linear(4, 6, bias=False), rank=2, n_adapters=1)
+    prefix = "model.language_model.layers.0.self_attn.q_proj"
+    state.register_module(prefix, module)
+    expected_a = torch.arange(8, dtype=torch.float32).reshape(2, 4)
+    expected_b = torch.arange(12, dtype=torch.float32).reshape(6, 2)
+    adapter = tmp_path / "adapter"
+    adapter.mkdir()
+    save_file(
+        {
+            f"base_model.model.{prefix}.lora_A.default.weight": expected_a,
+            f"base_model.model.{prefix}.lora_B.default.weight": expected_b,
+        },
+        adapter / "adapter_model.safetensors",
+    )
+
+    load_peft_adapter(adapter)
+
+    torch.testing.assert_close(module.lora_A[0], expected_a)
+    torch.testing.assert_close(module.lora_B[0], expected_b)
