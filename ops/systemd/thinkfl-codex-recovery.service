[Unit]
Description=ThinkFL training-data recovery using Codex
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/swlee/projects/rca-model-lab-mcp
Environment=PATH=/home/swlee/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/swlee/.local/bin/uv run python -u scripts/mcp_recover_data.py --config configs/teacher/data-recovery-codex-sol-20261007.yaml --workspace /home/swlee/projects/rca-model-lab-mcp/outputs/data-recovery-codex-sol-20261007 --execute
Restart=no
RestartForceExitStatus=3
RestartSec=1h
KillMode=control-group
TimeoutStopSec=30
StandardOutput=append:/home/swlee/projects/rca-model-lab-mcp/outputs/data-recovery-codex-sol-20261007/service.log
StandardError=inherit

[Install]
WantedBy=default.target
