[Unit]
Description=ThinkFL evidence admission then dataset-informed joint training
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/swlee/projects/rca-model-lab-mcp
Environment=PATH=/home/swlee/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/swlee/projects/rca-model-lab-mcp/.venv/bin/python -u scripts/mcp_run_admitted_recipe.py --config configs/sft/admitted-recipe-controller-20261008-all-turns.json
Restart=no
RestartForceExitStatus=3
RestartSec=1h
KillMode=control-group
TimeoutStopSec=30
StandardOutput=append:/home/swlee/projects/rca-model-lab-mcp/outputs/admitted-recipe-20261008-all-turns/service.log
StandardError=inherit

[Install]
WantedBy=default.target
