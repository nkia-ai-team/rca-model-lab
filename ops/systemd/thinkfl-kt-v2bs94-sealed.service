[Unit]
Description=KT v2bs checkpoint-94 sealed harness evaluation (24 runs)

[Service]
Type=simple
WorkingDirectory=/home/swlee/projects/rca-model-lab-mcp
Environment=PATH=/home/swlee/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/swlee/projects/rca-model-lab-mcp/.venv/bin/python /home/swlee/projects/rca-model-lab-mcp/outputs/kt-v2bs94-sealed-20261008/run.py
StandardOutput=append:/home/swlee/projects/rca-model-lab-mcp/outputs/kt-v2bs94-sealed-20261008/controller.log
