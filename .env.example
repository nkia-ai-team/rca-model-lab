# 복사해서 .env 로 사용. .env 는 git 에 올라가지 않는다.
# 데이터/모델/출력 루트. 기본은 레포 자체 (data/ models/ outputs/). 다른 디스크를 쓰려면 지정.
# RCA_LAB_DATA_ROOT=
# HF_HOME=
HF_TOKEN=
# 교사 모델은 claude / codex CLI 로 호출하므로 별도 API 키 불필요 (CLI 가 이미 로그인돼 있어야 함)
# 시나리오 소스 (rca-scenario-runner 체크아웃 경로)
RCA_SCENARIO_RUNNER_DIR=/home/ydkim/project-2025/rca-scenario-runner
